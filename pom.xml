<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven POM configuration for Recheck Scan API Extension
    
    This project builds a Burp Suite extension that helps track and manage
    API endpoint scanning status using SQLite database for persistence.
    
    Key features:
    - Automatic API parameter detection
    - Scan status tracking (scanned/rejected/bypassed)
    - SQLite database integration
    - User-friendly interface with tabs and statistics
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project identification -->
    <groupId>com.example</groupId>
    <artifactId>burp-recheck-scan</artifactId>
    <version>2.0-SQLITE</version>
    <name>Recheck Scan API Extension</name>
    <description>A Burp Suite extension for tracking API scanning status with SQLite persistence</description>

    <!-- Dependencies required for the extension -->
    <dependencies>
        <!-- Burp Suite Montoya API - Core interface for extension development -->
        <dependency>
            <groupId>net.portswigger.burp.extensions</groupId>
            <artifactId>montoya-api</artifactId>
            <version>2025.6</version>
            <scope>provided</scope> <!-- Provided by Burp Suite runtime -->
        </dependency>
        
        <!-- SQLite JDBC Driver - For database persistence -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.1.0</version>
        </dependency>

        <!-- JUnit 5 - Unit tests for the pure-logic helpers -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Build configuration -->
    <build>
        <!-- Output jar name: target/RecheckScan.jar -->
        <finalName>RecheckScan</finalName>
        <plugins>
            <!--
                Maven Shade Plugin - Creates the fat JARs.

                sqlite-jdbc ships a native library for 24 platform combinations (Android,
                FreeBSD, musl, ppc64, riscv64, 32-bit ARM...), about 24 MB uncompressed,
                while the extension's own code is roughly 50 KB. Shading every one of them
                into a single file makes the JAR ~14 MB for no benefit, so each execution
                below keeps only the natives that a given Burp installation can actually load.

                Four files come out of one build:
                  RecheckScan-win-x64.jar    Windows x86_64 only
                  RecheckScan-linux-x64.jar  Linux x86_64 only
                  RecheckScan-mac-arm64.jar  macOS Apple Silicon only
                  RecheckScan.jar            every common Burp platform (x86_64 + aarch64)

                The platform-specific executions run first and write through <outputFile>,
                which leaves the project's main artifact untouched; the bundle runs last and
                replaces it, so target/RecheckScan.jar stays the default output.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <!-- Include all dependencies except provided ones -->
                    <artifactSet>
                        <excludes>
                            <exclude>net.portswigger.burp.extensions:montoya-api</exclude>
                        </excludes>
                    </artifactSet>
                    <transformers>
                        <!-- Set main class for the JAR manifest -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>com.example.RecheckScanApiExtension</mainClass>
                        </transformer>
                        <!-- Handle service files properly -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <id>shade-win-x64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/${project.build.finalName}-win-x64.jar</outputFile>
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>org/sqlite/native/Linux/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                                        <exclude>org/sqlite/native/Mac/**</exclude>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/aarch64/**</exclude>
                                        <exclude>org/sqlite/native/Windows/armv7/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>

                    <execution>
                        <id>shade-linux-x64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/${project.build.finalName}-linux-x64.jar</outputFile>
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>org/sqlite/native/Windows/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                                        <exclude>org/sqlite/native/Mac/**</exclude>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/aarch64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>

                    <execution>
                        <id>shade-mac-arm64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/${project.build.finalName}-mac-arm64.jar</outputFile>
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>org/sqlite/native/Windows/**</exclude>
                                        <exclude>org/sqlite/native/Linux/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Mac/x86_64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>

                    <!--
                        Chạy sau cùng và KHÔNG có <outputFile> nên nó thay thế artifact chính,
                        tức target/RecheckScan.jar. Giữ natives cho mọi nền tảng Burp thông dụng.
                    -->
                    <execution>
                        <id>shade-all-platforms</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/armv7/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Maven Compiler Plugin - Set Java version -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin - Runs the JUnit 5 test suite -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
        </plugins>
    </build>

    <!-- Project properties -->
    <properties>
        <!-- Java version configuration -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Encoding configuration -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

</project>
